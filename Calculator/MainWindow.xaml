<Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" 
        Height="480" Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Margin="0,0,0,10">
            <MenuItem Header="Параметры">
                <MenuItem Header="Обычный режим" Click="StandardMode_Click"/>
                <MenuItem Header="Инженерный режим" Click="EngineerMode_Click"/>
                <Separator/>
                <MenuItem Header="Очистить историю" Click="ClearHistory_Click"/>
            </MenuItem>
        </Menu>
        <TextBox x:Name="DisplayTextBox" Grid.Row="1" 
                 FontSize="24" Height="45" TextAlignment="Right"
                 IsReadOnly="True" Margin="0,0,0,10"/>
        <ListBox x:Name="HistoryListBox" Grid.Row="2" 
                 Height="80" FontSize="11" Margin="0,0,0,10"/>
        <Grid x:Name="ButtonsGrid" Grid.Row="3">
            <Grid x:Name="StandardButtons" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btn7" Grid.Row="0" Grid.Column="0" Content="7" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn8" Grid.Row="0" Grid.Column="1" Content="8" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn9" Grid.Row="0" Grid.Column="2" Content="9" Click="Number_Click" Margin="5"/>
                <Button x:Name="btnDivide" Grid.Row="0" Grid.Column="3" Content="/" Click="Operation_Click" Margin="5"/>
                <Button x:Name="btn4" Grid.Row="1" Grid.Column="0" Content="4" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn5" Grid.Row="1" Grid.Column="1" Content="5" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn6" Grid.Row="1" Grid.Column="2" Content="6" Click="Number_Click" Margin="5"/>
                <Button x:Name="btnMultiply" Grid.Row="1" Grid.Column="3" Content="*" Click="Operation_Click" Margin="5"/>
                <Button x:Name="btn1" Grid.Row="2" Grid.Column="0" Content="1" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn2" Grid.Row="2" Grid.Column="1" Content="2" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn3" Grid.Row="2" Grid.Column="2" Content="3" Click="Number_Click" Margin="5"/>
                <Button x:Name="btnMinus" Grid.Row="2" Grid.Column="3" Content="-" Click="Operation_Click" Margin="5"/>
                <Button x:Name="btn0" Grid.Row="3" Grid.Column="0" Content="0" Click="Number_Click" Margin="5"/>
                <Button x:Name="btnC" Grid.Row="3" Grid.Column="1" Content="C" Click="Clear_Click" Margin="5"/>
                <Button x:Name="btnEquals" Grid.Row="3" Grid.Column="2" Content="=" Click="Equals_Click" Margin="5"/>
                <Button x:Name="btnPlus" Grid.Row="3" Grid.Column="3" Content="+" Click="Operation_Click" Margin="5"/>
                <Button x:Name="btnCE" Grid.Row="4" Grid.Column="0" Content="CE" Click="ClearEntry_Click" Margin="5"/>
                <Button x:Name="btnPercent" Grid.Row="4" Grid.Column="1" Content="%" Click="Percent_Click" Margin="5"/>
            </Grid>
            <Grid x:Name="EngineerButtons" Visibility="Collapsed" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnSquare" Grid.Row="0" Grid.Column="0" Content="x²" Click="Function_Click" Margin="5"/>
                <Button x:Name="btnSqrt" Grid.Row="0" Grid.Column="1" Content="√" Click="Function_Click" Margin="5"/>
                <Button x:Name="btnReciprocal" Grid.Row="0" Grid.Column="2" Content="1/x" Click="Function_Click" Margin="5"/>
                <Button x:Name="btnPercentE" Grid.Row="0" Grid.Column="3" Content="%" Click="Percent_Click" Margin="5"/>
                <Button x:Name="btn7e" Grid.Row="1" Grid.Column="0" Content="7" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn8e" Grid.Row="1" Grid.Column="1" Content="8" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn9e" Grid.Row="1" Grid.Column="2" Content="9" Click="Number_Click" Margin="5"/>
                <Button x:Name="btnDividee" Grid.Row="1" Grid.Column="3" Content="/" Click="Operation_Click" Margin="5"/>
                <Button x:Name="btn4e" Grid.Row="2" Grid.Column="0" Content="4" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn5e" Grid.Row="2" Grid.Column="1" Content="5" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn6e" Grid.Row="2" Grid.Column="2" Content="6" Click="Number_Click" Margin="5"/>
                <Button x:Name="btnMultiplye" Grid.Row="2" Grid.Column="3" Content="*" Click="Operation_Click" Margin="5"/>
                <Button x:Name="btn1e" Grid.Row="3" Grid.Column="0" Content="1" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn2e" Grid.Row="3" Grid.Column="1" Content="2" Click="Number_Click" Margin="5"/>
                <Button x:Name="btn3e" Grid.Row="3" Grid.Column="2" Content="3" Click="Number_Click" Margin="5"/>
                <Button x:Name="btnMinuse" Grid.Row="3" Grid.Column="3" Content="-" Click="Operation_Click" Margin="5"/>
                <Button x:Name="btn0e" Grid.Row="4" Grid.Column="0" Content="0" Click="Number_Click" Margin="5"/>
                <Button x:Name="btnCe" Grid.Row="4" Grid.Column="1" Content="C" Click="Clear_Click" Margin="5"/>
                <Button x:Name="btnEqualse" Grid.Row="4" Grid.Column="2" Content="=" Click="Equals_Click" Margin="5"/>
                <Button x:Name="btnPluse" Grid.Row="4" Grid.Column="3" Content="+" Click="Operation_Click" Margin="5"/>
                <Button x:Name="btnCEe" Grid.Row="5" Grid.Column="0" Content="CE" Click="ClearEntry_Click" Margin="5"/>
                <Button x:Name="btnPower" Grid.Row="5" Grid.Column="1" Content="xʸ" Click="Operation_Click" Margin="5"/>
                <Button x:Name="btnSin" Grid.Row="5" Grid.Column="2" Content="sin" Click="Function_Click" Margin="5"/>
                <Button x:Name="btnCos" Grid.Row="5" Grid.Column="3" Content="cos" Click="Function_Click" Margin="5"/>
            </Grid>
        </Grid>
    </Grid>
</Window>