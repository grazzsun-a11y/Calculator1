# Автоматически нормализовать окончания строк
* text=auto

# Исходный код — всегда LF в репозитории
*.cs      text diff=csharp
*.xaml    text
*.config  text
*.xml     text
*.json    text
*.md      text

# Скрипты — LF
*.sh      text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Бинарные файлы — не трогать
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.7z      binary
*.exe     binary
*.dll     binary
*.pdb     binary
*.suo     binary